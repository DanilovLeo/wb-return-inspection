    quality["<b>Контроль качества фото</b><br/>[Component: ONNX-модель]<br/>Резкость, свет, все ли ракурсы<br/>→ quality"]:::component
    refprov["<b>Поставщик эталонов</b><br/>[Component: Python + LRU-кэш]<br/>Эталонные эмбеддинги SKU"]:::component
    router["<b>Выбор версии модели</b><br/>[Component: клиент MLflow]<br/>Алиас production;<br/>если не загрузилась — previous"]:::component
